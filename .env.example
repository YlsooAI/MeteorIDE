# Supabase — set these to use real Supabase auth instead of local mock
# Get your URL and anon key from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# alternatively VITE_ prefix also works
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Or store in ~/.config/meteor/config.json as:
# { "supabaseUrl": "https://...", "supabaseAnonKey": "eyJ..." }

# Meteor API key (Sunlight)
METEOR_API_KEY=

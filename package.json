{
  "name": "meteor",
  "version": "0.2.0",
  "description": "Meteor — AI coding assistant (CLI + Electron app)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "meteor": "./bin/meteor.js"
  },
  "main": "dist/src-electron/main.js",
  "scripts": {
    "build": "tsc",
    "plan": "node scripts/plan.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "app": "npm run build && electron .",
    "app:plan": "npm run plan"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.4.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  }
}
